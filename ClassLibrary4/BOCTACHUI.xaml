<UserControl x:Class="ClassLibrary4.BOCTACHUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Width="360" Height="700"
             Unloaded="UserControl_Unloaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="127*"/>
            <ColumnDefinition Width="53*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1E1E1E" Grid.ColumnSpan="2">
            <TextBlock Text="THÁI ĐÌNH LÂM _ QS ĐẤU THẦU"
                       Foreground="White" FontWeight="Bold" FontSize="13"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="MainSystemTabs"
                        Margin="5"
                        Background="#FFF9F9F9"
                        TabStripPlacement="Right"
                        Grid.ColumnSpan="2">
                <TabControl.Resources>
                    <Style x:Key="TabNgangStyle" TargetType="RadioButton">
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Padding" Value="1"/>
                        <Setter Property="FontSize" Value="9"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="#FFE6E6E6"/>
                        <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter ContentSource="Content"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF777777"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFF3F3F3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- Mặc định: rê chuột 3s mới hiện ToolTip — áp dụng mọi Button -->
                    <Style TargetType="Button">
                        <Setter Property="ToolTipService.InitialShowDelay" Value="3000"/>
                        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
                        <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
                    </Style>

                    <Style x:Key="VatLieuItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="FontSize" Value="10.5"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="White"
                                            BorderBrush="#FFCCCCCC"
                                            BorderThickness="1"
                                            Margin="1">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF0078D7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFEAF4FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Padding" Value="15,10"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="#FFE6E6E6"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabItem Header="1. CHỮA CHÁY">
                    <Grid Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,2,2,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Vị trí:"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Foreground="#FF333333"/>
                            <TextBox x:Name="TxtViTriFF"
                                     Grid.Column="1"
                                     Height="28"
                                     FontSize="13"
                                     Padding="4"
                                     ToolTip="Nhập vị trí (vd: Tầng 1, Hầm P1…) — sẽ gắn vào tên Layer sau mã hệ thống"/>
                        </Grid>

                        <UniformGrid Grid.Row="1" Rows="1" Columns="4">
                            <RadioButton x:Name="RbDuongOng" Content="ĐƯỜNG ỐNG" GroupName="TabChuaChay" IsChecked="True" Style="{StaticResource TabNgangStyle}"/>
                            <RadioButton x:Name="RbVan" Content="VAN" GroupName="TabChuaChay" Style="{StaticResource TabNgangStyle}"/>
                            <RadioButton x:Name="RbThietBi" Content="THIẾT BỊ" GroupName="TabChuaChay" Style="{StaticResource TabNgangStyle}"/>
                            <RadioButton x:Name="RbThongKe" Content="THỐNG KÊ" GroupName="TabChuaChay" Style="{StaticResource TabNgangStyle}"/>
                        </UniformGrid>

                        <Grid Grid.Row="2" Margin="2,5,2,2">
                            <Grid VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbDuongOng}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel Orientation="Vertical">
                                    <ComboBox x:Name="CmbHeThong" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="CmbHeThong_SelectionChanged">
                                        <ComboBoxItem Content="Chữa cháy _ FF"/>
                                    </ComboBox>

                                    <ComboBox x:Name="CmbVatLieuOng" Visibility="Collapsed"/>

                                    <TextBlock Text="Chọn đường ống:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#FF333333"/>

                                    <ListBox x:Name="LstVatLieuOngBang"
                                             MinHeight="66" FontSize="11" BorderThickness="0" SelectedIndex="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource VatLieuItemStyle}"
                                             SelectionChanged="LstVatLieuOngBang_SelectionChanged"
                                             KeyDown="LstVatLieuOngBang_KeyDown">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemWidth="84" ItemHeight="32"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBoxItem Content="TRÁNG KẼM"/>
                                        <ListBoxItem Content="HDPE"/>
                                        <ListBoxItem Content="THÉP ĐEN"/>
                                        <ListBoxItem Content="INOX"/>
                                        <ListBoxItem Content="NHÚNG NÓNG"/>
                                    </ListBox>

                                    <TextBox x:Name="TxtVatLieuOngBoSung" Height="28" FontSize="12" Padding="4"
                                             Margin="0,4,0,10"
                                             ToolTip="Nhập thêm loại ống rồi nhấn Enter"
                                             KeyDown="TxtVatLieuOngBoSung_KeyDown"/>

                                    <TextBlock Text="Size ống (Kèm màu Layer):" FontWeight="Bold" Margin="0,0,0,5" Foreground="#FF333333"/>

                                    <ListBox x:Name="LstSizeOng" Height="140" FontSize="13" Margin="0,0,0,5"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             BorderBrush="#FFCCCCCC"
                                             KeyDown="LstSizeOng_KeyDown"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Width="20" Height="20"
                                                            Background="{Binding LayerColorBrush}"
                                                            Cursor="Hand" Click="BtnColor_Click"
                                                            ToolTip="Kích để chọn lại màu Layer"
                                                            BorderThickness="1" BorderBrush="Gray" Padding="0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBox x:Name="TxtCustomSize" Height="30" FontSize="13" Padding="4"
                                             ToolTip="Nhập kích thước rồi nhấn Enter"
                                             KeyDown="TxtCustomSize_KeyDown"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnVeOng"
                                                Grid.Column="0"
                                                Content="VẼ ỐNG 1"
                                                Height="35"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Background="#FF0078D7"
                                                Foreground="White"
                                                Cursor="Hand"
                                                ToolTipService.InitialShowDelay="3000"
                                                ToolTipService.ShowDuration="20000"
                                                Click="BtnVeOng_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="VẼ ỐNG 1: Chọn vật liệu + size trên bảng, bấm nút rồi vẽ PLINE trên bản vẽ. Layer và chữ size tự tạo theo lựa chọn (Vị trí / vật liệu / size / CN nếu có)."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button x:Name="BtnDoiLayer"
                                                Grid.Column="2"
                                                Content="ĐỔI LAYER"
                                                Height="35"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Background="#FF6F42C1"
                                                Foreground="White"
                                                Cursor="Hand"
                                                ToolTipService.InitialShowDelay="3000"
                                                ToolTipService.ShowDuration="20000"
                                                Click="BtnDoiLayer_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="ĐỔI LAYER: Chọn vật liệu + size trên bảng, bấm nút rồi quét chọn đối tượng trên bản vẽ. Đối tượng được chuyển sang layer mới, đổi độ dày nét và cập nhật chữ size."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </Grid>

                                    <Button x:Name="BtnVeOng2"
                                            Content="VẼ ỐNG 2"
                                            Height="35"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Background="#FF17A2B8"
                                            Foreground="White"
                                            Margin="0,10,0,0"
                                            Cursor="Hand"
                                            ToolTipService.InitialShowDelay="3000"
                                            ToolTipService.ShowDuration="20000"
                                            Click="BtnVeOng2_Click">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                           Text="VẼ ỐNG 2: Chọn vật liệu trên bảng (có thể tích CN), bấm nút rồi click text size trên bản vẽ (vd: PPR DN20). Tool lấy size từ text, tạo layer rồi vẽ PLINE liên tục."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnAutoConvertPipe"
                                                Grid.Column="0"
                                                Content="TĐ VẼ ỐNG"
                                                Height="35"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Background="#FFD35400"
                                                Foreground="White"
                                                Cursor="Hand"
                                                Click="BtnAutoConvertPipe_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="TĐ VẼ ỐNG: Quét chọn đường ống + text size trên bản vẽ. Tool nhận diện size (chữ song song ống), tách đoạn, gán layer và tạo chữ tự động."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button x:Name="BtnAutoDrawByTemplate"
                                                Grid.Column="2"
                                                Content="VẼ ỐNG MẪU"
                                                Height="35"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Background="#FF00875A"
                                                Foreground="White"
                                                Cursor="Hand"
                                                Click="BtnAutoDrawByTemplate_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="VẼ ỐNG MẪU: Chọn đoạn ống mẫu đã có layer/size, tool tìm các đoạn tương tự trên bản vẽ và áp dụng cùng layer, độ dày, chữ size."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbVan}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Chọn loại van:"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"
                                               Foreground="#FF333333"/>

                                    <ListBox x:Name="LstLoaiVan"
                                             MinHeight="66"
                                             FontSize="9.5"
                                             BorderThickness="0"
                                             SelectedIndex="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource VatLieuItemStyle}"
                                             SelectionChanged="LstLoaiVan_SelectionChanged"
                                             KeyDown="LstLoaiVan_KeyDown">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemWidth="84" ItemHeight="30"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBoxItem Content="V.CỔNG TN"/>
                                        <ListBoxItem Content="V.CỔNG TC"/>
                                        <ListBoxItem Content="VAN 1C"/>
                                        <ListBoxItem Content="V.CỔNG ĐIỆN"/>
                                        <ListBoxItem Content="Y LỌC"/>
                                        <ListBoxItem Content="KNM"/>
                                    </ListBox>

                                    <TextBox x:Name="TxtLoaiVanBoSung"
                                             Height="28"
                                             FontSize="12"
                                             Padding="4"
                                             Margin="0,4,0,10"
                                             ToolTip="Nhập thêm loại van rồi nhấn Enter"
                                             KeyDown="TxtLoaiVanBoSung_KeyDown"/>

                                    <TextBlock Text="Kích thước van (Kèm màu Layer):"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"
                                               Foreground="#FF333333"/>

                                    <ListBox x:Name="LstSizeVan"
                                             Height="140"
                                             FontSize="13"
                                             Margin="0,0,0,5"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             BorderBrush="#FFCCCCCC"
                                             KeyDown="LstSizeVan_KeyDown"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Width="20" Height="20"
                                                            Background="{Binding LayerColorBrush}"
                                                            Cursor="Hand"
                                                            Click="BtnColorVan_Click"
                                                            ToolTip="Kích để chọn lại màu Layer"
                                                            BorderThickness="1"
                                                            BorderBrush="Gray"
                                                            Padding="0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBox x:Name="TxtCustomSizeVan"
                                             Height="30"
                                             FontSize="13"
                                             Padding="4"
                                             ToolTip="Nhập kích thước rồi nhấn Enter"
                                             KeyDown="TxtCustomSizeVan_KeyDown"/>

                                    <Button x:Name="BtnDatVan"
                                            Content="ĐẶT VAN"
                                            Height="40"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Background="#FF0078D7"
                                            Foreground="White"
                                            Margin="0,12,0,0"
                                            Cursor="Hand"
                                            Click="BtnDatVan_Click">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                           Text="ĐẶT VAN: Chọn loại van + kích thước, bấm nút rồi click từng vị trí trên bản vẽ để đặt text. ESC để thoát. Layer tự tạo theo hệ / vị trí / loại van / size."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbThietBi}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Chọn thiết bị:"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"
                                               Foreground="#FF333333"/>

                                    <ListBox x:Name="LstLoaiThietBi"
                                             MinHeight="36"
                                             FontSize="9.5"
                                             BorderThickness="0"
                                             SelectedIndex="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource VatLieuItemStyle}"
                                             SelectionChanged="LstLoaiThietBi_SelectionChanged"
                                             KeyDown="LstLoaiThietBi_KeyDown">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemWidth="84" ItemHeight="30"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBoxItem Content="BÌNH CC"/>
                                        <ListBoxItem Content="ĐẦU PHUN"/>
                                    </ListBox>

                                    <TextBox x:Name="TxtLoaiThietBiBoSung"
                                             Height="28"
                                             FontSize="12"
                                             Padding="4"
                                             Margin="0,4,0,10"
                                             ToolTip="Nhập thêm loại thiết bị rồi nhấn Enter"
                                             KeyDown="TxtLoaiThietBiBoSung_KeyDown"/>

                                    <!-- Panel Bình CC: danh sách model -->
                                    <StackPanel x:Name="PanelBinhCC">
                                        <TextBlock Text="Model / Kích thước (Kèm màu Layer):"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"
                                                   Foreground="#FF333333"/>

                                        <ListBox x:Name="LstSizeThietBi"
                                                 Height="180"
                                                 FontSize="13"
                                                 Margin="0,0,0,5"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 BorderBrush="#FFCCCCCC"
                                                 KeyDown="LstSizeThietBi_KeyDown"
                                                 HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1"
                                                                Width="20" Height="20"
                                                                Background="{Binding LayerColorBrush}"
                                                                Cursor="Hand"
                                                                Click="BtnColorThietBi_Click"
                                                                ToolTip="Kích để chọn lại màu Layer"
                                                                BorderThickness="1"
                                                                BorderBrush="Gray"
                                                                Padding="0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBox x:Name="TxtCustomSizeThietBi"
                                                 Height="30"
                                                 FontSize="13"
                                                 Padding="4"
                                                 ToolTip="Nhập model/kích thước rồi nhấn Enter"
                                                 KeyDown="TxtCustomSizeThietBi_KeyDown"/>
                                    </StackPanel>

                                    <!-- Panel Đầu phun: 3 cột Hướng / K / Nhiệt độ -->
                                    <StackPanel x:Name="PanelDauPhun" Visibility="Collapsed">
                                        <TextBlock Text="Chọn thông số đầu phun:"
                                                   FontWeight="Bold"
                                                   Margin="0,0,0,5"
                                                   Foreground="#FF333333"/>

                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.7*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="0.65*"/>
                                                <ColumnDefinition Width="4"/>
                                                <ColumnDefinition Width="0.65*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Hướng"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,3"/>
                                                <ListBox x:Name="LstHuongDauPhun"
                                                         Height="130"
                                                         FontSize="11"
                                                         BorderBrush="#FFCCCCCC"
                                                         SelectedIndex="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         KeyDown="LstDauPhunCot_KeyDown">
                                                    <ListBoxItem Content="Hướng Lên"/>
                                                    <ListBoxItem Content="Hướng xuống"/>
                                                    <ListBoxItem Content="Hướng ngang"/>
                                                    <ListBoxItem Content="Hướng lên OG"/>
                                                    <ListBoxItem Content="Hướng xuống OG"/>
                                                </ListBox>
                                                <TextBox x:Name="TxtHuongDauPhunThem"
                                                         Height="26"
                                                         FontSize="11"
                                                         Padding="3"
                                                         Margin="0,3,0,0"
                                                         ToolTip="Nhập hướng mới rồi Enter"
                                                         KeyDown="TxtDauPhunCotThem_KeyDown"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Hệ số K"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,3"/>
                                                <ListBox x:Name="LstKDauPhun"
                                                         Height="130"
                                                         FontSize="11"
                                                         BorderBrush="#FFCCCCCC"
                                                         SelectedIndex="0"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         KeyDown="LstDauPhunCot_KeyDown">
                                                    <ListBoxItem Content="K5.6"/>
                                                    <ListBoxItem Content="K8.0"/>
                                                    <ListBoxItem Content="K11.2"/>
                                                    <ListBoxItem Content="K14"/>
                                                    <ListBoxItem Content="K25.2"/>
                                                </ListBox>
