                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=RbCtnVan}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Chọn loại van:" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                        <ListBox x:Name="LstLoaiVanCTN" MinHeight="56" FontSize="9" BorderThickness="0" SelectedIndex="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource VatLieuItemStyle}"
                                                 SelectionChanged="LstLoaiVan_SelectionChanged" KeyDown="LstLoaiVan_KeyDown">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemWidth="76" ItemHeight="28"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBoxItem Content="V.CỔNG TN"/>
                                            <ListBoxItem Content="V.CỔNG TC"/>
                                            <ListBoxItem Content="VAN 1C"/>
                                            <ListBoxItem Content="V.CỔNG ĐIỆN"/>
                                            <ListBoxItem Content="Y LỌC"/>
                                            <ListBoxItem Content="KNM"/>
                                        </ListBox>
                                        <TextBox x:Name="TxtLoaiVanBoSungCTN" Height="26" FontSize="11" Padding="4" Margin="0,3,0,8"
                                                 ToolTip="Nhập thêm loại van rồi nhấn Enter" KeyDown="TxtLoaiVanBoSung_KeyDown"/>

                                        <TextBlock Text="Kích thước van (Kèm màu Layer):" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                        <ListBox x:Name="LstSizeVanCTN" MinHeight="80" MaxHeight="150" FontSize="12" Margin="0,0,0,4"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#FFCCCCCC"
                                                 KeyDown="LstSizeVan_KeyDown" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Width="18" Height="18" Background="{Binding LayerColorBrush}"
                                                                Cursor="Hand" Click="BtnColorVan_Click" ToolTip="Kích để chọn lại màu Layer"
                                                                BorderThickness="1" BorderBrush="Gray" Padding="0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBox x:Name="TxtCustomSizeVanCTN" Height="28" FontSize="12" Padding="4"
                                                 ToolTip="Nhập kích thước rồi nhấn Enter" KeyDown="TxtCustomSizeVan_KeyDown"/>

                                        <Button x:Name="BtnDatVanCTN" Content="ĐẶT VAN" Height="36" FontSize="14" FontWeight="Bold"
                                                Background="#FF0078D7" Foreground="White" Margin="0,10,0,0" Cursor="Hand" Click="BtnDatVan_Click"/>
                                    </StackPanel>
                                </Grid>

                                <!-- THIẾT BỊ CTN -->
                                <Grid VerticalAlignment="Top">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=RbCtnThietBi}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Chọn thiết bị:" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                        <ListBox x:Name="LstLoaiThietBiCTN" MinHeight="32" FontSize="9" BorderThickness="0" SelectedIndex="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource VatLieuItemStyle}"
                                                 SelectionChanged="LstLoaiThietBi_SelectionChanged" KeyDown="LstLoaiThietBi_KeyDown">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemWidth="76" ItemHeight="28"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBoxItem Content="ĐỒNG HỒ"/>
                                            <ListBoxItem Content="BƠM"/>
                                            <ListBoxItem Content="BỒN"/>
                                        </ListBox>
                                        <TextBox x:Name="TxtLoaiThietBiBoSungCTN" Height="26" FontSize="11" Padding="4" Margin="0,3,0,8"
                                                 ToolTip="Nhập thêm loại thiết bị rồi nhấn Enter" KeyDown="TxtLoaiThietBiBoSung_KeyDown"/>

                                        <TextBlock Text="Model / Kích thước (Kèm màu Layer):" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                        <ListBox x:Name="LstSizeThietBiCTN" MinHeight="100" MaxHeight="160" FontSize="12" Margin="0,0,0,4"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#FFCCCCCC"
                                                 KeyDown="LstSizeThietBi_KeyDown" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Width="18" Height="18" Background="{Binding LayerColorBrush}"
                                                                Cursor="Hand" Click="BtnColorThietBi_Click" ToolTip="Kích để chọn lại màu Layer"
                                                                BorderThickness="1" BorderBrush="Gray" Padding="0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBox x:Name="TxtCustomSizeThietBiCTN" Height="28" FontSize="12" Padding="4"
                                                 ToolTip="Nhập model/kích thước rồi nhấn Enter" KeyDown="TxtCustomSizeThietBi_KeyDown"/>

                                        <Button x:Name="BtnDatThietBiCTN" Content="ĐẶT THIẾT BỊ" Height="36" FontSize="14" FontWeight="Bold"
                                                Background="#FF0078D7" Foreground="White" Margin="0,10,0,0" Cursor="Hand" Click="BtnDatThietBi_Click"/>

                                        <Button x:Name="BtnDatThietBiMauCTN" Content="ĐẶT THIẾT BỊ MẪU"
                                                Height="36" FontSize="13" FontWeight="Bold"
                                                Background="#FF00875A" Foreground="White"
                                                Margin="0,8,0,0" Cursor="Hand"
                                                Click="BtnDatThietBiMau_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="260" TextWrapping="Wrap"
                                                               Text="ĐẶT THIẾT BỊ MẪU: Chọn 1 text + 1 block mẫu đã đặt, Enter rồi quét vùng. Tool tìm các block giống mẫu và tự đặt text y hệt vị trí tương đối."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- SHOP CTN -->
                                <Grid VerticalAlignment="Top">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=RbCtnThongKe}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <StackPanel>
                                        <TextBlock Text="VẼ SHOP CTN"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Foreground="#FF0078D7"
                                                   Margin="0,0,0,6"/>

                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="#FF555555"
                                                   FontSize="11"
                                                   Margin="0,0,0,10"
                                                   Text="Giai đoạn 1: SHOP ống PPR. Quét tuyến ống + chữ D/DN. Tool tạo 2 nét theo đường kính ngoài và tự chèn phụ kiện từ Thu vien PPR.dwg."/>

                                        <Border BorderBrush="#FFB8B8B8"
                                                BorderThickness="1"
                                                CornerRadius="2"
                                                Padding="7"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="PPR"
                                                           FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="#FF00875A"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,5"/>

                                                <TextBlock TextWrapping="Wrap"
                                                           FontSize="10"
                                                           Foreground="#FF555555"
                                                           Margin="0,0,0,8"
                                                           Text="Block hỗ trợ: ELB90-D... PPR / ELB45-D... PPR / TEE-D...x... PPR / TEED-D...x... PPR / RED-D...x... PPR."/>

                                                <Button x:Name="BtnVeShopOngPprCTN"
                                                        Content="VẼ SHOP ỐNG PPR"
                                                        Height="40"
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Background="#FF00875A"
                                                        Foreground="White"
                                                        Cursor="Hand"
                                                        Click="BtnVeShopOngPprCTN_Click">
                                                    <Button.ToolTip>
                                                        <ToolTip>
                                                            <TextBlock MaxWidth="290"
                                                                       TextWrapping="Wrap"
                                                                       Text="VẼ SHOP PPR: Quét line/polyline/arc tuyến PPR và chữ D20, D25... hoặc DN. Tool dựng 2 nét đúng Ø ngoài PPR, tạo tim SHOP và chèn Co 90 / Lơi 45 / Tê / Tê giảm / Nối giảm từ file Thu vien PPR.dwg."/>
                                                        </ToolTip>
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="Gray"
                                                   FontSize="10"
                                                   Text="UPVC và chức năng ĐẶT TB CTN sẽ bổ sung sau khi SHOP PPR chạy ổn."/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>

                <!-- ==================== 4–8 ==================== -->
                <TabItem Header="4. ĐIỆN">
                    <Grid>
                        <TextBlock Text="Nội dung điện sẽ cập nhật sau..."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="5. ĐIỆN NHẸ">
                    <Grid>
                        <TextBlock Text="Nội dung điện nhẹ sẽ cập nhật sau..."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="6. THỐNG KÊ">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8">
                        <StackPanel>
                            <TextBlock Text="THỐNG KÊ TỔNG HỢP"
                                       FontWeight="Bold" FontSize="15"
                                       Foreground="#FF0078D7" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF555555" FontSize="11" Margin="0,0,0,14"
                                       Text="Áp dụng cho toàn bộ hệ thống FF / ACMV / CTN. Chỉ thống kê layer do tool tạo (FF_ / ACMV_ / CTN_)."/>

                            <Button Content="THỐNG KÊ ỐNG" Height="42" FontSize="14" FontWeight="Bold"
                                    Background="#FF0078D7" Foreground="White" Margin="0,0,0,10" Cursor="Hand"
                                    Click="BtnThongKeOng_Click">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="280" TextWrapping="Wrap"
                                                   Text="THỐNG KÊ ỐNG: Quét chọn vùng chứa đường ống. Tính tổng chiều dài theo Layer, sắp xếp theo Hệ thống rồi Kích thước. Đơn vị: mét. Chỉ layer FF_/ACMV_/CTN_."/>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>

                            <Button Content="THỐNG KÊ THIẾT BỊ + VAN" Height="42" FontSize="14" FontWeight="Bold"
                                    Background="#FF00875A" Foreground="White" Margin="0,0,0,10" Cursor="Hand"
                                    Click="BtnThongKeThietBiVan_Click">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="280" TextWrapping="Wrap"
                                                   Text="THỐNG KÊ THIẾT BỊ + VAN: Quét chọn vùng. Đếm số lượng text thiết bị/van theo Layer (bỏ chữ size ống). Sắp xếp theo Hệ thống. Đơn vị: cái."/>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>

                            <Button x:Name="BtnThongKePhuKienShop"
                                    Content="THỐNG KÊ PHỤ KIỆN"
                                    Height="42" FontSize="14" FontWeight="Bold"
                                    Background="#FF6F42C1" Foreground="White" Margin="0,0,0,10" Cursor="Hand"
                                    Click="BtnThongKePhuKienShop_Click">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="280" TextWrapping="Wrap"
                                                   Text="THỐNG KÊ PHỤ KIỆN SHOP: Quét vùng có phụ kiện do VẼ SHOP tạo. Tool đếm Co 90, Co 45/lơi, Tê và Giảm theo kích thước + kiểu nối SCREW/WELD rồi tạo bảng thống kê trong CAD."/>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>

                            <Button Content="TÌM ĐỐI TƯỢNG ĐƯỜNG THẲNG" Height="40" FontSize="12" FontWeight="Bold"
                                    Background="#FFE67E22" Foreground="White" Margin="0,0,0,10" Cursor="Hand"
                                    Click="BtnTimDoiTuongThongKe_Click">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="280" TextWrapping="Wrap"
                                                   Text="TÌM ĐỐI TƯỢNG ĐƯỜNG THẲNG: Click vào tên Layer trên bảng thống kê. Tool vẽ đường thẳng từ ô đó tới các đối tượng cùng Layer trên bản vẽ. ESC/Enter để xóa đường và kết thúc."/>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>

                            <Button Content="TÌM ĐỐI TƯỢNG KHOANH TRÒN" Height="40" FontSize="12" FontWeight="Bold"
                                    Background="#FF9B59B6" Foreground="White" Margin="0,0,0,10" Cursor="Hand"
                                    Click="BtnTimDoiTuongKhoanhTron_Click">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <TextBlock MaxWidth="280" TextWrapping="Wrap"
                                                   Text="TÌM ĐỐI TƯỢNG KHOANH TRÒN: Click vào tên Layer trên bảng thống kê. Tool đổi chữ/đối tượng cùng Layer sang màu vàng, các đối tượng khác sang màu xám, và vẽ vòng tròn tạm bao quanh chữ để nhìn vị trí nhanh hơn. ESC/Enter để xóa khoanh tròn và kết thúc."/>
                                    </ToolTip>
                                </Button.ToolTip>
                            </Button>

                            <Border BorderBrush="#FFCCCCCC" BorderThickness="1" Padding="8" Margin="0,8,0,0" Background="#FFF9F9F9">
                                <StackPanel>
                                    <TextBlock Text="Hướng dẫn nhanh" FontWeight="Bold" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF444444"
                                               Text="1. Thống kê ống / thiết bị+van / phụ kiện → quét vùng → đặt bảng&#10;2. Tìm đường thẳng → click tên Layer → xem đường chỉ&#10;3. Tìm khoanh tròn → click tên Layer → khoanh chữ target&#10;4. ESC/Enter để xóa dấu tạm"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="7. EXCEL">
                    <Grid>
                        <TextBlock Text="Chức năng Excel sẽ cập nhật sau..."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="8. AI">
                    <Grid>
                        <TextBlock Text="Chức năng AI sẽ cập nhật sau..."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="Gray" FontStyle="Italic"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>