                                                            Cursor="Hand"
                                                            Click="BtnColor_Click"
                                                            ToolTip="Kích để chọn lại màu Layer"
                                                            BorderThickness="1"
                                                            BorderBrush="Gray"
                                                            Padding="0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBox x:Name="TxtCustomSizeCTN"
                                             Height="30"
                                             FontSize="13"
                                             Padding="4"
                                             ToolTip="Nhập kích thước rồi nhấn Enter"
                                             KeyDown="TxtCustomSize_KeyDown"/>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnVeOngCTN"
                                                Grid.Column="0"
                                                Content="VẼ ỐNG 1"
                                                Height="35"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Background="#FF0078D7"
                                                Foreground="White"
                                                Cursor="Hand"
                                                ToolTipService.InitialShowDelay="3000"
                                                ToolTipService.ShowDuration="20000"
                                                Click="BtnVeOng_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="VẼ ỐNG 1: Chọn vật liệu + size trên bảng, bấm nút rồi vẽ PLINE trên bản vẽ. Layer và chữ size tự tạo theo lựa chọn (Vị trí / vật liệu / size / CN nếu có)."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button x:Name="BtnDoiLayerCTN"
                                                Grid.Column="2"
                                                Content="ĐỔI LAYER"
                                                Height="35"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Background="#FF6F42C1"
                                                Foreground="White"
                                                Cursor="Hand"
                                                ToolTipService.InitialShowDelay="3000"
                                                ToolTipService.ShowDuration="20000"
                                                Click="BtnDoiLayer_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="ĐỔI LAYER: Chọn vật liệu + size trên bảng, bấm nút rồi quét chọn đối tượng trên bản vẽ. Đối tượng được chuyển sang layer mới, đổi độ dày nét và cập nhật chữ size."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </Grid>

                                    <Button x:Name="BtnVeOng2CTN"
                                            Content="VẼ ỐNG 2"
                                            Height="35"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Background="#FF17A2B8"
                                            Foreground="White"
                                            Margin="0,10,0,0"
                                            Cursor="Hand"
                                            ToolTipService.InitialShowDelay="3000"
                                            ToolTipService.ShowDuration="20000"
                                            Click="BtnVeOng2_Click">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                           Text="VẼ ỐNG 2: Chọn vật liệu trên bảng (có thể tích CN), bấm nút rồi click text size trên bản vẽ (vd: PPR DN20). Tool lấy size từ text, tạo layer rồi vẽ PLINE liên tục."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button x:Name="BtnAutoConvertPipeCTN"
                                                Grid.Column="0"
                                                Content="TĐ VẼ ỐNG"
                                                Height="35"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Background="#FFD35400"
                                                Foreground="White"
                                                Cursor="Hand"
                                                Click="BtnAutoConvertPipe_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="TĐ VẼ ỐNG: Quét chọn đường ống + text size trên bản vẽ. Tool nhận diện size (chữ song song ống), tách đoạn, gán layer và tạo chữ tự động."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <Button x:Name="BtnAutoDrawByTemplateCTN"
                                                Grid.Column="2"
                                                Content="VẼ ỐNG MẪU"
                                                Height="35"
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Background="#FF00875A"
                                                Foreground="White"
                                                Cursor="Hand"
                                                Click="BtnAutoDrawByTemplate_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="VẼ ỐNG MẪU: Chọn đoạn ống mẫu đã có layer/size, tool tìm các đoạn tương tự trên bản vẽ và áp dụng cùng layer, độ dày, chữ size."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Grid VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbCtnVan}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Chọn loại van:"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"
                                               Foreground="#FF333333"/>

                                    <ListBox x:Name="LstLoaiVanCTN"
                                             MinHeight="66"
                                             FontSize="9.5"
                                             BorderThickness="0"
                                             SelectedIndex="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource VatLieuItemStyle}"
                                             SelectionChanged="LstLoaiVan_SelectionChanged"
                                             KeyDown="LstLoaiVan_KeyDown">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemWidth="84" ItemHeight="30"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBoxItem Content="V.CỔNG TN"/>
                                        <ListBoxItem Content="V.CỔNG TC"/>
                                        <ListBoxItem Content="VAN 1C"/>
                                        <ListBoxItem Content="V.CỔNG ĐIỆN"/>
                                        <ListBoxItem Content="Y LỌC"/>
                                        <ListBoxItem Content="KNM"/>
                                    </ListBox>

                                    <TextBox x:Name="TxtLoaiVanBoSungCTN"
                                             Height="28"
                                             FontSize="12"
                                             Padding="4"
                                             Margin="0,4,0,10"
                                             ToolTip="Nhập thêm loại van rồi nhấn Enter"
                                             KeyDown="TxtLoaiVanBoSung_KeyDown"/>

                                    <TextBlock Text="Kích thước van (Kèm màu Layer):"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"
                                               Foreground="#FF333333"/>

                                    <ListBox x:Name="LstSizeVanCTN"
                                             Height="140"
                                             FontSize="13"
                                             Margin="0,0,0,5"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             BorderBrush="#FFCCCCCC"
                                             KeyDown="LstSizeVan_KeyDown"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Width="20" Height="20"
                                                            Background="{Binding LayerColorBrush}"
                                                            Cursor="Hand"
                                                            Click="BtnColorVan_Click"
                                                            ToolTip="Kích để chọn lại màu Layer"
                                                            BorderThickness="1"
                                                            BorderBrush="Gray"
                                                            Padding="0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBox x:Name="TxtCustomSizeVanCTN"
                                             Height="30"
                                             FontSize="13"
                                             Padding="4"
                                             ToolTip="Nhập kích thước rồi nhấn Enter"
                                             KeyDown="TxtCustomSizeVan_KeyDown"/>

                                    <Button x:Name="BtnDatVanCTN"
                                            Content="ĐẶT VAN"
                                            Height="40"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Background="#FF0078D7"
                                            Foreground="White"
                                            Margin="0,12,0,0"
                                            Cursor="Hand"
                                            Click="BtnDatVan_Click">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                           Text="ĐẶT VAN: Chọn loại van + kích thước, bấm nút rồi click từng vị trí trên bản vẽ để đặt text. ESC để thoát."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbCtnThietBi}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Chọn thiết bị:"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"
                                               Foreground="#FF333333"/>

                                    <ListBox x:Name="LstLoaiThietBiCTN"
                                             MinHeight="36"
                                             FontSize="9.5"
                                             BorderThickness="0"
                                             SelectedIndex="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemContainerStyle="{StaticResource VatLieuItemStyle}"
                                             SelectionChanged="LstLoaiThietBi_SelectionChanged"
                                             KeyDown="LstLoaiThietBi_KeyDown">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemWidth="84" ItemHeight="30"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBoxItem Content="ĐỒNG HỒ"/>
                                        <ListBoxItem Content="BƠM"/>
                                        <ListBoxItem Content="BỒN"/>
                                    </ListBox>

                                    <TextBox x:Name="TxtLoaiThietBiBoSungCTN"
                                             Height="28"
                                             FontSize="12"
                                             Padding="4"
                                             Margin="0,4,0,10"
                                             ToolTip="Nhập thêm loại thiết bị rồi nhấn Enter"
                                             KeyDown="TxtLoaiThietBiBoSung_KeyDown"/>

                                    <TextBlock Text="Model / Kích thước (Kèm màu Layer):"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5"
                                               Foreground="#FF333333"/>

                                    <ListBox x:Name="LstSizeThietBiCTN"
                                             Height="160"
                                             FontSize="13"
                                             Margin="0,0,0,5"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             BorderBrush="#FFCCCCCC"
                                             KeyDown="LstSizeThietBi_KeyDown"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1"
                                                            Width="20" Height="20"
                                                            Background="{Binding LayerColorBrush}"
                                                            Cursor="Hand"
                                                            Click="BtnColorThietBi_Click"
                                                            ToolTip="Kích để chọn lại màu Layer"
                                                            BorderThickness="1"
                                                            BorderBrush="Gray"
                                                            Padding="0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBox x:Name="TxtCustomSizeThietBiCTN"
                                             Height="30"
                                             FontSize="13"
                                             Padding="4"
                                             ToolTip="Nhập model/kích thước rồi nhấn Enter"
                                             KeyDown="TxtCustomSizeThietBi_KeyDown"/>

                                    <Button x:Name="BtnDatThietBiCTN"
                                            Content="ĐẶT THIẾT BỊ"
                                            Height="40"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Background="#FF0078D7"
                                            Foreground="White"
                                            Margin="0,12,0,0"
                                            Cursor="Hand"
                                            Click="BtnDatThietBi_Click">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                           Text="ĐẶT THIẾT BỊ: Chọn loại thiết bị + model, bấm nút rồi click từng vị trí trên bản vẽ để đặt text. ESC để thoát."/>
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Grid VerticalAlignment="Top">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RbCtnThongKe}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <StackPanel>
                                    <TextBlock Text="THỐNG KÊ CTN"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#FF0078D7"
                                               Margin="0,0,0,10"/>
                                    <TextBlock Text="Bạn xây dựng nội dung riêng của tab THỐNG KÊ tại đây."
                                               Foreground="Gray"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="4. ĐIỆN">
                    <Grid>
                        <TextBlock Text="Nội dung điện sẽ cập nhật sau..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="5. ĐIỆN NHẸ">
                    <Grid>
                        <TextBlock Text="Nội dung điện nhẹ sẽ cập nhật sau..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="6. PHỤ TRỢ">
                    <Grid>
                        <TextBlock Text="Chức năng phụ trợ sẽ cập nhật sau..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="7. EXCEL">
                    <Grid>
                        <TextBlock Text="Chức năng Excel sẽ cập nhật sau..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   FontStyle="Italic"/>
                    </Grid>
                </TabItem>

                <TabItem Header="8. AI">
                    <Grid>
                        <TextBlock Text="Chức năng AI sẽ cập nhật sau..."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   FontStyle="Italic"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>