<UserControl x:Class="ClassLibrary4.BOCTACHUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White"
             Width="Auto"
             MinWidth="280"
             MinHeight="320"
             SizeChanged="UserControl_SizeChanged"
             Unloaded="UserControl_Unloaded">

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="127*"/>
            <ColumnDefinition Width="53*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF1E1E1E" Grid.ColumnSpan="2">
            <TextBlock Text="THÁI ĐÌNH LÂM _ QS ĐẤU THẦU"
                       Foreground="White" FontWeight="Bold" FontSize="13"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TabControl x:Name="MainSystemTabs"
                        Margin="5"
                        Background="#FFF9F9F9"
                        TabStripPlacement="Right"
                        Grid.ColumnSpan="2">

                <TabControl.Resources>
                    <Style x:Key="TabNgangStyle" TargetType="RadioButton">
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Padding" Value="1"/>
                        <Setter Property="FontSize" Value="9"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="#FFE6E6E6"/>
                        <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter ContentSource="Content"
                                                          Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF777777"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFF3F3F3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="Button">
                        <Setter Property="ToolTipService.InitialShowDelay" Value="3000"/>
                        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
                        <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
                    </Style>

                    <Style x:Key="VatLieuItemStyle" TargetType="ListBoxItem">
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Padding" Value="2"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="White"
                                            BorderBrush="#FFCCCCCC"
                                            BorderThickness="1"
                                            Margin="1">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF0078D7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FFEAF4FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style x:Key="AdaptiveTileItemStyle"
                           TargetType="ListBoxItem"
                           BasedOn="{StaticResource VatLieuItemStyle}">
                        <Setter Property="Height" Value="26"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="FontSize" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="BdAdaptive"
                                            Background="White"
                                            BorderBrush="#FFCCCCCC"
                                            BorderThickness="1"
                                            Margin="1">
                                        <Viewbox Stretch="Uniform"
                                                 StretchDirection="DownOnly"
                                                 Margin="3,1">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                        </Viewbox>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="BdAdaptive"
                                                    Property="Background"
                                                    Value="#FF0078D7"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BdAdaptive"
                                                    Property="Background"
                                                    Value="#FFEAF4FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <RotateTransform Angle="90"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="#FFE6E6E6"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ==================== 1. CHỮA CHÁY ==================== -->
                <TabItem Header="1. CHỮA CHÁY">
                    <Grid Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="2,2,2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vị trí:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FF333333"/>
                            <TextBox x:Name="TxtViTriFF" Grid.Column="1" Height="26" FontSize="12" Padding="4"
                                     ToolTip="Nhập vị trí (vd: Tầng 1, Hầm P1…) — sẽ gắn vào tên Layer sau mã hệ thống"/>
                        </Grid>

                        <UniformGrid Grid.Row="1" Rows="1" Columns="4">
                            <RadioButton x:Name="RbDuongOng" Content="ĐƯỜNG ỐNG" GroupName="TabChuaChay" IsChecked="True" Style="{StaticResource TabNgangStyle}"/>
                            <RadioButton x:Name="RbVan" Content="VAN" GroupName="TabChuaChay" Style="{StaticResource TabNgangStyle}"/>
                            <RadioButton x:Name="RbThietBi" Content="THIẾT BỊ" GroupName="TabChuaChay" Style="{StaticResource TabNgangStyle}"/>
                            <RadioButton x:Name="RbThongKe" Content="VẼ SHOP" GroupName="TabChuaChay" Style="{StaticResource TabNgangStyle}"/>
                        </UniformGrid>

                        <ScrollViewer Grid.Row="2" Margin="2,4,2,2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <Grid>
                                <!-- ĐƯỜNG ỐNG -->
                                <Grid VerticalAlignment="Top">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=RbDuongOng}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel Orientation="Vertical">
                                        <ComboBox x:Name="CmbHeThong" Visibility="Collapsed" SelectedIndex="0">
                                            <ComboBoxItem Content="Chữa cháy _ FF"/>
                                        </ComboBox>
                                        <ComboBox x:Name="CmbVatLieuOng" Visibility="Collapsed"/>

                                        <TextBlock Text="Chọn đường ống:" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                        <ListBox x:Name="LstVatLieuOngBang" MinHeight="56" FontSize="10" BorderThickness="0" SelectedIndex="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource AdaptiveTileItemStyle}"
                                                 SelectionChanged="LstVatLieuOngBang_SelectionChanged" KeyDown="LstVatLieuOngBang_KeyDown">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBoxItem Content="TRÁNG KẼM"/>
                                            <ListBoxItem Content="HDPE"/>
                                            <ListBoxItem Content="THÉP ĐEN"/>
                                            <ListBoxItem Content="INOX"/>
                                            <ListBoxItem Content="NHÚNG NÓNG"/>
                                        </ListBox>
                                        <TextBox x:Name="TxtVatLieuOngBoSung" Height="26" FontSize="11" Padding="4" Margin="0,3,0,8"
                                                 ToolTip="Nhập thêm loại ống rồi nhấn Enter" KeyDown="TxtVatLieuOngBoSung_KeyDown"/>

                                        <TextBlock Text="Size ống (Kèm màu Layer):" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                        <ListBox x:Name="LstSizeOng" MinHeight="80" MaxHeight="150" FontSize="12" Margin="0,0,0,4"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#FFCCCCCC"
                                                 KeyDown="LstSizeOng_KeyDown" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Width="18" Height="18" Background="{Binding LayerColorBrush}"
                                                                Cursor="Hand" Click="BtnColor_Click" ToolTip="Kích để chọn lại màu Layer"
                                                                BorderThickness="1" BorderBrush="Gray" Padding="0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBox x:Name="TxtCustomSize" Height="28" FontSize="12" Padding="4"
                                                 ToolTip="Nhập kích thước rồi nhấn Enter" KeyDown="TxtCustomSize_KeyDown"/>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnVeOng" Grid.Column="0" Content="VẼ ỐNG 1" Height="32" FontSize="13" FontWeight="Bold"
                                                    Background="#FF0078D7" Foreground="White" Cursor="Hand" Click="BtnVeOng_Click">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                                   Text="VẼ ỐNG 1: Chọn vật liệu + size trên bảng, bấm nút rồi vẽ PLINE trên bản vẽ. Layer và chữ size tự tạo theo lựa chọn (Vị trí / vật liệu / size / CN nếu có)."/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                            <Button x:Name="BtnDoiLayer" Grid.Column="2" Content="ĐỔI LAYER" Height="32" FontSize="13" FontWeight="Bold"
                                                    Background="#FF6F42C1" Foreground="White" Cursor="Hand" Click="BtnDoiLayer_Click">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                                   Text="ĐỔI LAYER: Chọn vật liệu + size trên bảng, bấm nút rồi quét chọn đối tượng trên bản vẽ. Đối tượng được chuyển sang layer mới, đổi độ dày nét và cập nhật chữ size."/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                        </Grid>

                                        <Button x:Name="BtnVeOng2" Content="VẼ ỐNG 2" Height="32" FontSize="13" FontWeight="Bold"
                                                Background="#FF17A2B8" Foreground="White" Margin="0,8,0,0" Cursor="Hand" Click="BtnVeOng2_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="VẼ ỐNG 2: Chọn vật liệu trên bảng (có thể tích CN), bấm nút rồi click text size trên bản vẽ (vd: PPR DN20). Tool lấy size từ text, tạo layer rồi vẽ PLINE liên tục."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="BtnAutoConvertPipe" Grid.Column="0" Content="TĐ VẼ ỐNG" Height="32" FontSize="12" FontWeight="Bold"
                                                    Background="#FFD35400" Foreground="White" Cursor="Hand" Click="BtnAutoConvertPipe_Click">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                                   Text="TĐ VẼ ỐNG: Quét chọn đường ống + text size trên bản vẽ. Tool nhận diện size (chữ song song ống), tách đoạn, gán layer và tạo chữ tự động."/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                            <Button x:Name="BtnAutoDrawByTemplate" Grid.Column="2" Content="VẼ ỐNG MẪU" Height="32" FontSize="12" FontWeight="Bold"
                                                    Background="#FF00875A" Foreground="White" Cursor="Hand" Click="BtnAutoDrawByTemplate_Click">
                                                <Button.ToolTip>
                                                    <ToolTip>
                                                        <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                                   Text="VẼ ỐNG MẪU: Chọn đoạn ống mẫu đã có layer/size, tool tìm các đoạn tương tự trên bản vẽ và áp dụng cùng layer, độ dày, chữ size."/>
                                                    </ToolTip>
                                                </Button.ToolTip>
                                            </Button>
                                        </Grid>

                                        <!-- Nút SHOP thủ công: đặt thành một hàng riêng, luôn hiện ngay dưới hai nút tự động -->
                                        <Button x:Name="BtnVeShopThuCong" Content="VẼ SHOP THỦ CÔNG" Height="36" MinHeight="36"
                                                Margin="0,8,0,0" HorizontalAlignment="Stretch" Visibility="Visible" Panel.ZIndex="10"
                                                FontSize="12" FontWeight="Bold" Background="#FF005A9C" Foreground="White"
                                                Cursor="Hand" Click="BtnVeShopThuCong_Click"/>

                                        <!-- Trục đứng: lấy hệ/vật liệu/size đang chọn, nhập hướng + chiều cao -->
                                        <Button x:Name="BtnTrucDung" Content="VẼ TRỤC ĐỨNG" Height="36" MinHeight="36"
                                                Margin="0,8,0,0" HorizontalAlignment="Stretch" Visibility="Visible" Panel.ZIndex="10"
                                                FontSize="12" FontWeight="Bold" Background="#FFE46C0A" Foreground="White"
                                                Cursor="Hand" Click="BtnTrucDung_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="280" TextWrapping="Wrap"
                                                               Text="TRỤC ĐỨNG: Chọn vật liệu + size, nhập hướng lên/xuống và chiều cao (m), sau đó đặt ký hiệu trên bản vẽ. Chiều dài trục đứng được cộng tự động trong THỐNG KÊ ỐNG."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>

                                        <!-- Kiểm tra mô hình 3D: ống ngang + trục đứng + cảnh báo đầu hở -->
                                        <Button x:Name="BtnKiemTra3D" Content="KIỂM TRA 3D" Height="38" MinHeight="38"
                                                Margin="0,8,0,0" HorizontalAlignment="Stretch" Visibility="Visible" Panel.ZIndex="10"
                                                FontSize="13" FontWeight="Bold" Background="#FF2E7D32" Foreground="White"
                                                Cursor="Hand" Click="BtnKiemTra3D_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="300" TextWrapping="Wrap"
                                                               Text="KIỂM TRA 3D: Nhập cao độ ống ngang, chọn vùng hoặc toàn bộ. Tool dựng đường tâm 3D tạm, dựng trục đứng đúng chiều cao và đánh dấu các đầu ống hở / trục đứng chưa nối. Bấm lại nút để làm mới hoặc xóa mô hình 3D."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- VAN -->
                                <Grid VerticalAlignment="Top">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=RbVan}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Chọn loại van:" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                        <ListBox x:Name="LstLoaiVan" MinHeight="56" FontSize="9" BorderThickness="0" SelectedIndex="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource AdaptiveTileItemStyle}"
                                                 SelectionChanged="LstLoaiVan_SelectionChanged" KeyDown="LstLoaiVan_KeyDown">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBoxItem Content="V.CỔNG TN"/>
                                            <ListBoxItem Content="V.CỔNG TC"/>
                                            <ListBoxItem Content="VAN 1C"/>
                                            <ListBoxItem Content="V.CỔNG ĐIỆN"/>
                                            <ListBoxItem Content="Y LỌC"/>
                                            <ListBoxItem Content="KNM"/>
                                            <ListBoxItem Content="VAN BƯỚM"/>
                                            <ListBoxItem Content="V. XẢ KHÍ"/>
                                            <ListBoxItem Content="ĐH ĐO L. LƯỢNG"/>
                                            <ListBoxItem Content="V. BÁO ĐỘNG"/>
                                        </ListBox>
                                        <TextBox x:Name="TxtLoaiVanBoSung" Height="26" FontSize="11" Padding="4" Margin="0,3,0,8"
                                                 ToolTip="Nhập thêm loại van rồi nhấn Enter" KeyDown="TxtLoaiVanBoSung_KeyDown"/>

                                        <TextBlock Text="Kích thước van (Kèm màu Layer):" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                        <ListBox x:Name="LstSizeVan" MinHeight="80" MaxHeight="150" FontSize="12" Margin="0,0,0,4"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#FFCCCCCC"
                                                 KeyDown="LstSizeVan_KeyDown" HorizontalContentAlignment="Stretch">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Width="18" Height="18" Background="{Binding LayerColorBrush}"
                                                                Cursor="Hand" Click="BtnColorVan_Click" ToolTip="Kích để chọn lại màu Layer"
                                                                BorderThickness="1" BorderBrush="Gray" Padding="0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBox x:Name="TxtCustomSizeVan" Height="28" FontSize="12" Padding="4"
                                                 ToolTip="Nhập kích thước rồi nhấn Enter" KeyDown="TxtCustomSizeVan_KeyDown"/>

                                        <Button x:Name="BtnDatVan" Content="ĐẶT VAN" Height="36" FontSize="14" FontWeight="Bold"
                                                Background="#FF0078D7" Foreground="White" Margin="0,10,0,0" Cursor="Hand" Click="BtnDatVan_Click">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock MaxWidth="240" TextWrapping="Wrap"
                                                               Text="ĐẶT VAN: Chọn loại van + kích thước, bấm nút rồi click từng vị trí trên bản vẽ để đặt text. ESC để thoát. Layer tự tạo theo hệ / vị trí / loại van / size."/>
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- THIẾT BỊ -->
                                <Grid VerticalAlignment="Top">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=RbThietBi}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="Chọn thiết bị:" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                        <ListBox x:Name="LstLoaiThietBi" MinHeight="32" FontSize="9" BorderThickness="0" SelectedIndex="0"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ItemContainerStyle="{StaticResource AdaptiveTileItemStyle}"
                                                 SelectionChanged="LstLoaiThietBi_SelectionChanged" KeyDown="LstLoaiThietBi_KeyDown">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBoxItem Content="BÌNH CC"/>
                                            <ListBoxItem Content="ĐẦU PHUN"/>
                                            <ListBoxItem Content="BÁO KHÓI - NHIỆT"/>
                                            <ListBoxItem Content="EXIT"/>
                                            <ListBoxItem Content="EMERGENCY"/>
                                        </ListBox>
                                        <TextBox x:Name="TxtLoaiThietBiBoSung" Height="26" FontSize="11" Padding="4" Margin="0,3,0,8"
                                                 ToolTip="Nhập thêm loại thiết bị rồi nhấn Enter" KeyDown="TxtLoaiThietBiBoSung_KeyDown"/>

                                        <StackPanel x:Name="PanelBinhCC">
                                            <TextBlock Text="Model / Kích thước (Kèm màu Layer):" FontWeight="Bold" Margin="0,0,0,4" Foreground="#FF333333"/>
                                            <ListBox x:Name="LstSizeThietBi" MinHeight="100" MaxHeight="180" FontSize="12" Margin="0,0,0,4"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="#FFCCCCCC"
                                                     KeyDown="LstSizeThietBi_KeyDown" HorizontalContentAlignment="Stretch">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="1" Width="18" Height="18" Background="{Binding LayerColorBrush}"
                                                                    Cursor="Hand" Click="BtnColorThietBi_Click" ToolTip="Kích để chọn lại màu Layer"
                                                                    BorderThickness="1" BorderBrush="Gray" Padding="0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
