<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>

		<!-- AutoCAD 2025 + ONNX Runtime native đều chạy x64 -->
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>

		<!-- Giữ dependency NuGet/native cạnh DLL output để NETLOAD ổn định -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- STEP24: cho phép pointer LockBits trong MepSymbolClassifier để giảm GC allocation -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="accoremgd">
			<HintPath>..\..\..\..\..\..\..\Program Files\Autodesk\AutoCAD 2025\accoremgd.dll</HintPath>
		</Reference>
		<Reference Include="Acdbmgd">
			<HintPath>..\..\..\..\..\..\..\Program Files\Autodesk\AutoCAD 2025\acdbmgd.dll</HintPath>
		</Reference>
		<Reference Include="Acmgd">
			<HintPath>..\..\..\..\..\..\..\Program Files\Autodesk\AutoCAD 2025\acmgd.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>