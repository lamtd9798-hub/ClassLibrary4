<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>

		<!-- AutoCAD 2025 + ONNX Runtime + OpenCV: x64 -->
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<GenerateDependencyFile>true</GenerateDependencyFile>

		<!-- Giữ dependency NuGet/native cạnh DLL output để NETLOAD ổn định -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- STEP24: unsafe LockBits trong MepSymbolClassifier vẫn giữ cho hot path -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />

		<!--
		  STEP29A - OpenCV Vision Engine.
		  KHÔNG dùng OpenCvSharp4.Extensions 4.13 tại đây: package đó kéo
		  System.Drawing.Common 10.x vào AutoCAD 2025 (.NET 8) và gây
		  FileLoadException khi bấm AI. Việc đổi Bitmap <-> Mat đã được
		  MepOpenCvBitmapBridge xử lý bằng API lõi của OpenCvSharp4.
		-->
		<!-- Analyzer 4.13 hiện được build bằng compiler mới hơn SDK .NET 8;
		     loại riêng analyzer, không ảnh hưởng OpenCvSharp runtime/API. -->
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" ExcludeAssets="analyzers" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />

		<!--
      STEP26A FIX:
      AutoCAD 2025 official Autodesk NuGet.
      Giữ toàn bộ compile/build assets; chỉ loại runtime để AutoCAD host
      dùng AcMgd/AcDbMgd/AcCoreMgd của chính thư mục cài AutoCAD.
    -->
		<PackageReference Include="AutoCAD.NET" Version="25.0.1" ExcludeAssets="runtime" PrivateAssets="all" />
	</ItemGroup>

	<!-- Lệnh DEMTHIETBI thử nghiệm cũ: không compile. -->
	<ItemGroup>
		<Compile Remove="Class1.cs" />
	</ItemGroup>

	<!-- Config public của license được copy cạnh ClassLibrary4.dll. -->
	<ItemGroup>
		<None Update="license_client_config.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!--
	  Nếu người dùng Build đè lên thư mục bin cũ, xóa các DLL 10.x còn sót
	  từ OpenCvSharp4.Extensions. AutoCAD cung cấp System.Drawing.Common 8
	  từ Windows Desktop Runtime; không được nạp bản 10 cạnh plugin.
	-->
	<Target Name="RemoveStaleDrawingBridgeAssemblies" AfterTargets="Build">
		<Delete Files="$(TargetDir)OpenCvSharp.Extensions.dll;$(TargetDir)System.Drawing.Common.dll;$(TargetDir)Microsoft.Win32.SystemEvents.dll" />
	</Target>

	<!-- Package 4.13 đang đóng kèm analyzer build bằng Roslyn 4.14, trong khi
	     SDK .NET 8 dùng Roslyn 4.11. Gỡ analyzer build-time này trước CoreCompile;
	     thư viện OpenCvSharp runtime không bị ảnh hưởng. -->
	<Target Name="RemoveIncompatibleOpenCvSharpAnalyzer" BeforeTargets="CoreCompile">
		<ItemGroup>
			<Analyzer Remove="@(Analyzer)"
				Condition="'%(Analyzer.Filename)' == 'OpenCvSharp.Analyzers'" />
		</ItemGroup>
	</Target>

	<!--
	  NETLOAD convenience: sau mỗi Build thành công, luôn cập nhật đúng file
	  ClassLibrary4.V25.dll ở thư mục project gốc. Đây là file người dùng
	  đang NETLOAD trong AutoCAD. Đóng AutoCAD trước Build nếu DLL đang bị khóa.
	-->
	<Target Name="CopyLatestPluginToNetloadRoot" AfterTargets="Build">
		<Copy SourceFiles="$(TargetPath)"
			  DestinationFiles="$(ProjectDir)ClassLibrary4.V25.dll"
			  SkipUnchangedFiles="false" />
	</Target>

</Project>
